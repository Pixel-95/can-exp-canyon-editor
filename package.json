{
  "name": "can-exp-canyon-editor",
  "version": "0.1.0",
  "description": "Canyon Editor - Electron Mapbox route editor with GeoJSON export",
  "main": "dist/electron/main.js",
  "author": "Canyon Editor Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:build\" \"npm:dev:electron:run\"",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "dev:web": "vite --config renderer/vite.config.ts",
    "dev:electron:build": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:electron:run": "wait-on tcp:5173 dist/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 nodemon --watch dist/electron --ext js --exec \"electron .\"",
    "typecheck": "tsc -b --noEmit",
    "test:unit:build": "tsc -p tests/tsconfig.json",
    "test:unit": "npm run test:unit:build && node --test \".tmp/unit-tests/**/*.test.js\"",
    "check:context-sync": "node scripts/check-context-sync.mjs",
    "check:context-sync:staged": "node scripts/check-context-sync.mjs --staged",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build:web": "vite build --config renderer/vite.config.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview:web": "vite preview --config renderer/vite.config.ts",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win portable",
    "package:mac": "npm run build && electron-builder --mac dir --x64",
    "package:mac:zip": "npm run build && electron-builder --mac dir zip --x64",
    "package:mac:catalina": "npm run package:mac",
    "package:mac:catalina:zip": "npm run package:mac:zip",
    "package:dist": "node scripts/assemble-distributions.mjs",
    "package:win:dist": "npm run package:win && npm run package:dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.1.1",
    "jszip": "^3.10.1",
    "mapbox-gl": "^3.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.canexp.canyoneditor",
    "productName": "Canyon Editor",
    "icon": "build/icon.png",
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.png",
      "minimumSystemVersion": "10.15.0",
      "target": [
        "dir"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    }
  }
}
